# Copy to .env for Expo Go / local development only.
# Preview and production builds read these from EAS env, not this file.

# Express API (elva-investa-admin-portal). A physical phone cannot use 127.0.0.1.
# Example: http://192.168.1.10:4000
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000

# Cloud database project (same Supabase Postgres Express uses). Not a backend.
EXPO_PUBLIC_SUPABASE_URL=https://rcexagktpinoalceodyc.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Required on EAS preview + production after the API is deployed (public HTTPS).
# eas env:set EXPO_PUBLIC_API_URL https://your-api.example.com --environment preview --visibility plaintext
# eas env:set EXPO_PUBLIC_API_URL https://your-api.example.com --environment production --visibility plaintext

# Elvatech OTP (used by the app for registration send / resend / verify)
EXPO_PUBLIC_OTP_API_BASE_URL=https://api.notify.elvatech.in
EXPO_PUBLIC_OTP_APP_ID=eNandi
EXPO_PUBLIC_OTP_API_KEY=your_otp_api_key
EXPO_PUBLIC_OTP_BRAND_ID=elva-sales
