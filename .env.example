# Copy to .env and fill in your Supabase project values.
# Do not commit .env to version control.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Elvatech OTP (used by the app for send / resend / verify)
EXPO_PUBLIC_OTP_API_BASE_URL=https://api.notify.elvatech.in
EXPO_PUBLIC_OTP_APP_ID=eNandi
EXPO_PUBLIC_OTP_API_KEY=your_otp_api_key
EXPO_PUBLIC_OTP_BRAND_ID=elva-sales

# Optional (schema apply scripts only — never commit)
SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=your-project-ref

# For secure password reset via edge function (recommended for production):
#   supabase secrets set OTP_APP_ID=eNandi OTP_API_KEY=your_secret OTP_BRAND_ID=elva-sales
#   supabase functions deploy otp
